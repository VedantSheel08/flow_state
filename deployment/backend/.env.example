API_DOMAIN=api.flowstate.nyc
FLOWSTATE_ALLOWED_ORIGINS=https://flowstate.nyc,https://www.flowstate.nyc
# Optional bearer token for POST endpoints (the UI does not send one yet; leave empty)
FLOWSTATE_ACCESS_TOKEN=
FLOWSTATE_MAX_WS_CLIENTS=25
# Per-IP limits also apply: FLOWSTATE_RATE_LIMIT, FLOWSTATE_START_LIMIT, FLOWSTATE_MAX_WS_PER_IP, FLOWSTATE_MAX_DURATION_MIN
