# Optional: point at an existing SUMO install instead of the pip package
# SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo
# Backend address the Vite dev server proxies to
FLOWSTATE_API=http://127.0.0.1:8000
# traci (default, separate SUMO process) or libsumo (in-process, experimental)
FLOWSTATE_BACKEND=traci
