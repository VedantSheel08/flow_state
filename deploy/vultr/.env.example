# Copy to .env on the server (chmod 600). Never commit .env and never put these values in frontend code.
FLOWSTATE_BACKEND=libsumo
# Tiger Cloud / any PostgreSQL: the service URL from the console (includes sslmode=require). Leave empty to use the local SQLite fallback.
FLOWSTATE_DATABASE_URL=
# Optional: Gemini scenario assistant (Google AI Studio key). Leave empty to use the rule-based fallback.
GEMINI_API_KEY=
GEMINI_MODEL=
# Only for the optional TLS proxy profile
DOMAIN=
